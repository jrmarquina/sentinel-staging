# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
out/

# Environment files — NEVER commit these
.env
.env.local
.env.*.local
.env.staging
apps/web/.env.local

# Supabase
.supabase/
supabase/.temp/

# Turbo
.turbo/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Misc
.tmp/
*.sql.gz.gpg

# Google OAuth (server-side only, never commit)
credentials.json
token.json
.env.staging-health

# next-pwa build output (regenerated on every `next build`, bakes in
# that build's chunk-revision hashes — committing it goes stale immediately)
apps/web/public/sw.js
apps/web/public/workbox-*.js
apps/web/public/fallback-*.js

# Claude Code local tooling state
.claude/worktrees/

# graphify knowledge-graph output (rebuilt from source, see .graphifyignore)
graphify-out/
