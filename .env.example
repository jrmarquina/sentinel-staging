# =============================================================
# Sentinel Public Works — Environment Variables
# Copy this file to .env (root) and apps/web/.env.local
# NEVER commit actual values — this file has placeholders only
# =============================================================

# Supabase (self-hosted)
NEXT_PUBLIC_SUPABASE_URL=https://db.yourdomain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database (direct connection for migrations)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=alerts@yourdomain.com

# Backups
BACKUP_PASSPHRASE=change-this-to-a-strong-random-passphrase
B2_KEY_ID=your-backblaze-key-id
B2_APPLICATION_KEY=your-backblaze-app-key
B2_BUCKET_NAME=sentinel-backups

# Novu (self-hosted notifications)
NOVU_API_KEY=your-novu-api-key
NEXT_PUBLIC_NOVU_APP_ID=your-novu-app-id

# Twilio (SMS + WhatsApp) — add when credentials confirmed
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Slack — add when workspace confirmed
SLACK_WEBHOOK_URL=

# Map (OpenFreeMap requires no key — only add if switching providers)
# NEXT_PUBLIC_MAPTILER_KEY=

# Guaynabo geographic constants
NEXT_PUBLIC_MAP_CENTER_LNG=-66.0858
NEXT_PUBLIC_MAP_CENTER_LAT=18.3830
NEXT_PUBLIC_MAP_ZOOM=13
NEXT_PUBLIC_MAP_BOUNDS_SW="-66.1197,18.3394"
NEXT_PUBLIC_MAP_BOUNDS_NE="-66.0519,18.4267"
