# =============================================================
# Sentinel Public Works — PRODUCTION Environment Variables
# Copy to /srv/sentinel/municipal-public-works/apps/web/.env.local
# Fill in real values before starting PM2
# =============================================================

# Supabase (cloud project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Email (Resend)
RESEND_API_KEY=re_YOUR_RESEND_KEY
SMTP_FROM=alerts@sentinelmgpr.com

# Backups (Backblaze B2)
BACKUP_PASSPHRASE=CHANGE_TO_STRONG_RANDOM_PASSPHRASE
B2_KEY_ID=YOUR_B2_KEY_ID
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY
B2_BUCKET_NAME=sentinel-backups

# Novu (optional — leave empty if not set up yet)
NOVU_API_KEY=
NEXT_PUBLIC_NOVU_APP_ID=

# Twilio (optional — leave empty if not set up yet)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Slack (optional)
SLACK_WEBHOOK_URL=

# Map — Guaynabo geographic constants (no API key needed for OpenFreeMap)
NEXT_PUBLIC_MAP_CENTER_LNG=-66.0858
NEXT_PUBLIC_MAP_CENTER_LAT=18.3830
NEXT_PUBLIC_MAP_ZOOM=13
NEXT_PUBLIC_MAP_BOUNDS_SW="-66.1197,18.3394"
NEXT_PUBLIC_MAP_BOUNDS_NE="-66.0519,18.4267"
