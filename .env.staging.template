# =============================================================
# Sentinel Public Works — STAGING Environment Variables
#
# Copy to /srv/sentinel/staging/.env.staging on the VPS.
# Fill in all values before running deploy-staging.sh.
# NEVER commit this file — it is .gitignored.
#
# Staging uses a completely separate Supabase stack:
#   API  : http://localhost:8100  (prod: 8000)
#   DB   : localhost:5434         (prod: 5432)
#   Studio: http://localhost:3004 (prod: 3000)
# =============================================================

# ── Supabase core secrets (generate separately from prod) ────
# Generate JWT secret: openssl rand -base64 32
JWT_SECRET=CHANGE_TO_STAGING_JWT_SECRET_MIN_32_CHARS
# Generate anon key from JWT: supabase start or use jwt.io with role=anon
ANON_KEY=CHANGE_TO_STAGING_ANON_KEY
# Generate service_role key: jwt.io with role=service_role
SERVICE_ROLE_KEY=CHANGE_TO_STAGING_SERVICE_ROLE_KEY

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_TO_STAGING_DB_PASSWORD
# Direct connection URL (used by migrations and backup script)
DATABASE_URL=postgresql://postgres:CHANGE_TO_STAGING_DB_PASSWORD@localhost:5434/postgres

# ── JWT settings ──────────────────────────────────────────────
JWT_EXPIRY=3600

# ── URLs ──────────────────────────────────────────────────────
# The public-facing URL for the staging Supabase API
# Set to your staging subdomain once Nginx is configured
SUPABASE_PUBLIC_URL=https://staging-db.yourdomain.com
API_EXTERNAL_URL=https://staging-db.yourdomain.com
# The URL of the staging Next.js app (used by Supabase Auth redirects)
SITE_URL=https://staging.yourdomain.com
ADDITIONAL_REDIRECT_URLS=https://staging.yourdomain.com/**

# ── Next.js (staging) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://staging-db.yourdomain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_TO_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_TO_STAGING_SERVICE_ROLE_KEY

# ── Supabase Auth email settings ─────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=staging@sentinelmgpr.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=CHANGE_TO_RESEND_API_KEY
SMTP_SENDER_NAME=Sentinel Staging
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ── PostgREST ─────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── Realtime ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32
REALTIME_DB_ENC_KEY=CHANGE_TO_STAGING_ENC_KEY
# Generate: openssl rand -base64 64
REALTIME_SECRET_KEY_BASE=CHANGE_TO_STAGING_SECRET_KEY_BASE

# ── Analytics / Logflare ──────────────────────────────────────
# Generate: openssl rand -hex 16
LOGFLARE_API_KEY=CHANGE_TO_STAGING_LOGFLARE_KEY

# ── Storage / Images ──────────────────────────────────────────
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ── Studio ────────────────────────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=Sentinel Staging
STUDIO_DEFAULT_PROJECT=municipal-public-works-staging
DASHBOARD_USERNAME=staging-admin
DASHBOARD_PASSWORD=CHANGE_TO_STAGING_DASHBOARD_PASSWORD

# ── Edge Functions ────────────────────────────────────────────
FUNCTIONS_VERIFY_JWT=false

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_CHANGE_TO_STAGING_RESEND_KEY
SMTP_FROM=staging@sentinelmgpr.com

# ── Map constants (same geographic bounds as prod) ────────────
NEXT_PUBLIC_MAP_CENTER_LNG=-66.0858
NEXT_PUBLIC_MAP_CENTER_LAT=18.3830
NEXT_PUBLIC_MAP_ZOOM=13
NEXT_PUBLIC_MAP_BOUNDS_SW="-66.1197,18.3394"
NEXT_PUBLIC_MAP_BOUNDS_NE="-66.0519,18.4267"

# ── Backups (staging — optional, can skip or use separate bucket) ─
BACKUP_PASSPHRASE=CHANGE_TO_STAGING_BACKUP_PASSPHRASE
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=sentinel-backups-staging

# ── Novu / Twilio / Slack (staging — safe to leave empty) ────
NOVU_API_KEY=
NEXT_PUBLIC_NOVU_APP_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SLACK_WEBHOOK_URL=
